{
  "name": "@inso_web/els-express",
  "version": "0.5.2",
  "description": "Express middleware for @inso_web/els-client with request-scoped logging (req.log) and an error handler. A drop-in replacement for pino-http and morgan + winston.",
  "homepage": "https://els.insoweb.ru",
  "author": "INSOWEB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "docs", "examples", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "express",
    "express-middleware",
    "logger",
    "logging",
    "structured-logging",
    "request-logger",
    "error-tracking",
    "error-monitoring",
    "observability",
    "pino-http-alternative",
    "morgan-alternative",
    "winston-alternative",
    "loki-alternative",
    "els",
    "inso",
    "insoweb"
  ],
  "license": "MIT",
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "dependencies": {
    "@inso_web/els-client": "^0.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.18.2",
    "supertest": "^6.3.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
